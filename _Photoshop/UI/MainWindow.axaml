<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="MyPhotoshop.MainWindow"
    Title="Photoshop pre-alpha release"
    Width="1000"
    Height="800"
    CanResize="False">

    <Grid ColumnDefinitions="Auto,10,200" RowDefinitions="Auto,Auto,*">
        <Image x:Name="OriginalImage"
               Grid.Row="0" Grid.Column="0"
               Stretch="Uniform"
               Margin="10"/>

        <Image x:Name="ProcessedImage"
               Grid.Row="1" Grid.Column="0"
               Stretch="Uniform"
               Margin="10"/>

        <StackPanel Grid.Column="2" Grid.Row="0" Grid.RowSpan="3" Margin="10">
            <ComboBox x:Name="FiltersSelect"
                      HorizontalAlignment="Stretch"
                      PlaceholderText="Выберите фильтр"
                      SelectionChanged="FilterChanged"/>
            
            <ScrollViewer Height="400" Margin="0,10,0,10">
                <StackPanel x:Name="ParametersPanel" />
            </ScrollViewer>

            <Button x:Name="ApplyButton"
                    Content="Применить"
                    Height="40"
                    HorizontalAlignment="Stretch"
                    IsEnabled="False"/>
        </StackPanel>
    </Grid>
</Window>